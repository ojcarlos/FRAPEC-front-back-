# ==============================================================================
# PROJETO: MONITORAMENTO E PREVISÃO DE ALAGAMENTOS E DESLIZAMENTOS (MANAUS - AM)
# ARQUIVO DE CONFIGURAÇÃO DE CREDENCIAIS (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NASA Earthdata Login (Bearer Token)
# ------------------------------------------------------------------------------
# Obtenha em: https://urs.earthdata.nasa.gov/users/tokens
EARTHDATA_TOKEN=seu_bearer_token_aqui_da_nasa_earthdata

# ------------------------------------------------------------------------------
# 2. INMET (Instituto Nacional de Meteorologia)
# ------------------------------------------------------------------------------
# Token para API REST do INMET (opcional)
INMET_TOKEN=seu_token_api_inmet_se_aplicavel

# ------------------------------------------------------------------------------
# 3. Meteomatics Weather API (Dados Meteorológicos em Tempo Real)
# ------------------------------------------------------------------------------
# Cadastre-se em: https://www.meteomatics.com/en/weather-api/
# Para autenticação HTTP Basic Auth (Usuário e Senha da sua conta Meteomatics)
METEOMATICS_USERNAME=seu_usuario_meteomatics
METEOMATICS_PASSWORD=sua_senha_meteomatics
